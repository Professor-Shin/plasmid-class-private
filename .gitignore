# Python
__pycache__/
*.pyc

# --- dataset pipeline1 ---
# Raw downloaded/source data: multi-GB, regenerable from NCBI via the pipeline
# scripts (see dataset pipeline1/README.md). Never fits GitHub's 100MB file limit.
dataset pipeline1/assembly_summary.txt
dataset pipeline1/data/raw/
dataset pipeline1/data/fasta/
dataset pipeline1/data/dataset/*.fasta
# Same rule for the mixed-length dataset (fragments.mode: random_length).
dataset pipeline1/data/dataset_mixed/*.fasta
# Metadata CSVs (traceability, all under 100MB) are kept, e.g.
# data/metadata/*.csv, data/dataset/*.csv, data/split/*.csv, reports/, logs/

# --- baseline ---
# k-mer feature caches and per-fragment probability arrays: tens of GB,
# regenerated by prepare_features.py / run_*.py (see baseline/README.md).
baseline/cache/
baseline/cache_mixed/
baseline/results/probs/
baseline/results_mixed/probs/
# run_composition.py writes its test probabilities beside its JSON/CSV summaries;
# the summaries are kept, the raw per-fragment arrays are not.
baseline/results_mixed/*.npy

# --- esm2-attention ---
# ESM-2 embeddings and per-fragment probability arrays: regenerated by
# extract_features.py / train_eval.py (see esm2-attention/README.md).
esm2-attention/cache/
esm2-attention/cache_mixed/
esm2-attention/results/probs/
esm2-attention/results_mixed/probs/

# --- tools-baseline (Platon / MOB-suite) ---
# Per-assembly shard FASTAs (367 MB, regenerated by shard_by_assembly.py) and the
# raw tool output trees (regenerated by the 11_platon / 12_mobsuite arrays). The
# fragment-level prediction CSVs and the scored summaries ARE kept.
tools-baseline/shards/
tools-baseline/out/
baseline/results_mixed/predictions_*.csv

# --- server run ---
# The GPU run's embedding cache is 5.2 GiB (8.79 M ORFs x 320, float16) and its
# checkpoints are regenerable from it.
esm2-attention/cache_server/
esm2-attention/results_server/probs/
esm2-attention/results_server/checkpoints/
esm2-attention/results_regression/
esm2-attention/config_regression.yaml
# Job logs and the checksum manifest are machine-specific. The directory itself
# must survive a fresh clone, because Slurm cannot create the parent of
# --output and the job would die before running.
server/logs/*
!server/logs/.gitkeep
server/dataset_md5.txt

# --- reference PDFs kept locally, deliberately not in the repo ---
# The CU-AIM manual that server/README.md cites, and an unrelated course
# document. Both are read-only references, not part of the project's code.
survival-manual-cuaim.pdf
The Siwak System CI Guideline.pdf

# --- server working dirs created INSIDE the repo ---
# On CU-AIM the project directory IS the clone, and env.sh points conda, pip,
# HuggingFace, tmp and the tool databases at $PROJECT/... So these appear inside
# the working tree and MUST be ignored: without this, `git add -A` on the server
# would try to stage several GB of conda environments and GB-scale databases.
envs/
db/
containers/
tmp/
.hf/
.conda-pkgs/
.pip-cache/
.singularity-cache/
.singularity-tmp/
.cuda_tag

# per-machine CU-AIM values (see server/env.local.sh.example)
server/env.local.sh

# rebuild path (server/01b_rebuild_fasta_from_ncbi.py)
server/dataset_md5.origin.txt
