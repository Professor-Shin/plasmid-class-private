#!/bin/bash
# Per-machine CU-AIM values. Copy to server/env.local.sh (gitignored) and edit:
#
#   cp server/env.local.sh.example server/env.local.sh
#
# env.sh sources this file FIRST, then applies its own defaults with
# : "${VAR:=...}", so whatever is exported here wins and `git pull` never
# conflicts with it. Fill from `bash server/probe_server.sh`.

# --- required ---------------------------------------------------------------
export PROJECT="/data/project/<group>/<your_dir>"

# Slurm account from check_group / sacctmgr (section 1 of the probe).
# Leave this line commented out to submit without --account, which is correct
# when the account is your default - an EMPTY --account= is rejected by Slurm.
#export CUAIM_ACCOUNT="g_<group>"

# --- override only if the probe disagrees with env.sh's defaults ------------
#export PART_CPU=cpu
#export PART_GPU=gpu
#export QOS_CPU=cpu40h
#export QOS_GPU=gpu40g
#export GRES_GPU=gpu:7g.40gb:1
#export MODULE_CONDA=Anaconda3
#export MODULE_CUDA=CUDA/11.8.0

# Wall clock: read the MaxWall column of `check_qos`, not the manual's table.
# On CU-AIM gpu40g is 08:00:00 (eight hours); gpu10gh gives 4 days on a smaller
# 2g.10gb MIG slice.
#export TIME_EMBED=08:00:00
#export TIME_TRAIN=08:00:00

# A standalone micromamba, if you installed one to keep conda's classic solver
# from being OOM-killed (see MANUAL.md step 2).
#export PATH="$PROJECT/bin:$PATH"
